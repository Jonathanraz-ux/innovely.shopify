<section id="methode" class="bg-paper">
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
    <div class="mx-auto max-w-2xl text-center">
      <div class="reveal in-view">
        <p class="eyebrow">{% render 'translate', key: 'innovely.how_it_works.eyebrow', fallback: section.settings.eyebrow %}</p>
      </div>
      <div class="reveal in-view" style="transition-delay: 80ms;">
        <h2 class="mt-6 font-display text-4xl leading-[1.1] tracking-tight sm:text-5xl">
          {% render 'translate', key: 'innovely.how_it_works.title', fallback: section.settings.title %}
        </h2>
      </div>
      <div class="reveal in-view" style="transition-delay: 160ms;">
        <p class="mt-6 text-lg leading-relaxed text-muted">{% render 'translate', key: 'innovely.how_it_works.subtitle', fallback: section.settings.subtitle %}</p>
      </div>
    </div>

    <div class="relative mt-20">
      <!-- connecting line -->
      <div aria-hidden="true" class="absolute left-8 top-2 hidden h-px w-full max-w-[calc(100%-4rem)] bg-gradient-to-r from-transparent via-line to-transparent lg:block lg:left-1/2 lg:-translate-x-1/2 lg:max-w-[70%]"></div>

      <div class="grid gap-6 lg:grid-cols-3 lg:gap-8">
        {% for block in section.blocks %}
          <div class="reveal in-view" style="transition-delay: {{ forloop.index0 | times: 140 }}ms;">
            <article class="group relative h-full rounded-4xl border border-line bg-paper p-8 transition-all duration-500 hover:-translate-y-1.5 hover:border-brand/40 hover:shadow-card lg:p-10">
              <span class="absolute right-8 top-8 font-display text-5xl text-line transition-colors duration-500 group-hover:text-brand-mist">
                0{{ forloop.index }}
              </span>
              <div class="relative inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand text-paper shadow-soft">
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
              </div>
              <h3 class="mt-8 max-w-[24ch] font-display text-2xl leading-snug">
                {%- assign step_title_key = 'innovely.how_it_works.step' | append: forloop.index | append: '_title' -%}
                {%- if block.settings.title != blank -%}
                  {{ block.settings.title }}
                {%- else -%}
                  {% render 'translate', key: step_title_key, fallback: block.settings.title %}
                {%- endif -%}
              </h3>
              <p class="mt-4 leading-relaxed text-muted">
                {%- assign step_text_key = 'innovely.how_it_works.step' | append: forloop.index | append: '_text' -%}
                {%- if block.settings.text != blank -%}
                  {{ block.settings.text }}
                {%- else -%}
                  {% render 'translate', key: step_text_key, fallback: block.settings.text %}
                {%- endif -%}
              </p>
            </article>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom How It Works",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE METHOD"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "How it works"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A simple method to retrain your posture every day."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step 1"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Description of step 1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Analyze your posture",
            "text": "Place the sensor on your back. It automatically calibrates your ideal posture in real time."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Feel the vibration",
            "text": "As soon as you slouch, a gentle vibration reminds you to straighten up without any pain."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Strengthen your back",
            "text": "Day after day, you build the muscle memory needed to stand up straight without thinking about it."
          }
        }
      ]
    }
  ]
}
{% endschema %}
