<section id="methode" class="bg-paper">
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
    <div class="mx-auto max-w-2xl text-center">
      <div class="reveal in-view">
        <p class="eyebrow">{% render 'translate', key: 'innovely.how_it_works.eyebrow', fallback: section.settings.eyebrow %}</p>
      </div>
      <div class="reveal in-view" style="transition-delay: 80ms;">
        <h2 class="mt-6 font-display text-4xl leading-[1.1] tracking-tight sm:text-5xl">
          {% render 'translate', key: 'innovely.how_it_works.title', fallback: section.settings.title %}
        </h2>
      </div>
      <div class="reveal in-view" style="transition-delay: 160ms;">
        <p class="mt-6 text-lg leading-relaxed text-muted">{% render 'translate', key: 'innovely.how_it_works.subtitle', fallback: section.settings.subtitle %}</p>
      </div>
    </div>

    <div class="relative mt-20">
      <!-- connecting line -->
      <div aria-hidden="true" class="absolute left-8 top-2 hidden h-px w-full max-w-[calc(100%-4rem)] bg-gradient-to-r from-transparent via-line to-transparent lg:block lg:left-1/2 lg:-translate-x-1/2 lg:max-w-[70%]"></div>

      <div class="grid gap-6 lg:grid-cols-3 lg:gap-8">
        {% for block in section.blocks %}
          <div class="reveal in-view" style="transition-delay: {{ forloop.index0 | times: 140 }}ms;">
            <article class="group relative h-full rounded-4xl border border-line bg-paper p-8 transition-all duration-500 hover:-translate-y-1.5 hover:border-brand/40 hover:shadow-card lg:p-10">
              <span class="absolute right-8 top-8 font-display text-5xl text-line transition-colors duration-500 group-hover:text-brand-mist">
                0{{ forloop.index }}
              </span>
              <div class="relative inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand text-paper shadow-soft">
                {%- if forloop.index == 1 -%}
                  <!-- Sensor/Scan/Target -->
                  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
                  </svg>
                {%- elsif forloop.index == 2 -%}
                  <!-- Vibration/Waves/Bell -->
                  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 0 0 3.4 0M4 4c-.7.7-1.5 1.6-1.9 2.6M20 4c.7.7 1.5 1.6 1.9 2.6"></path>
                  </svg>
                {%- elsif forloop.index == 3 -%}
                  <!-- Muscle/Shield/Success -->
                  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="m9 11 2 2 4-4"></path>
                  </svg>
                {%- else -%}
                  <!-- Fallback: generic activity icon -->
                  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                  </svg>
                {%- endif -%}
              </div>
              <h3 class="mt-8 max-w-[24ch] font-display text-2xl leading-snug">
                {%- if forloop.index == 1 -%}
                  {% render 'translate', key: 'innovely.how_it_works.step1_title', fallback: block.settings.title %}
                {%- elsif forloop.index == 2 -%}
                  {% render 'translate', key: 'innovely.how_it_works.step2_title', fallback: block.settings.title %}
                {%- elsif forloop.index == 3 -%}
                  {% render 'translate', key: 'innovely.how_it_works.step3_title', fallback: block.settings.title %}
                {%- else -%}
                  {{ block.settings.title }}
                {%- endif -%}
              </h3>
              <p class="mt-4 leading-relaxed text-muted">
                {%- if forloop.index == 1 -%}
                  {% render 'translate', key: 'innovely.how_it_works.step1_text', fallback: block.settings.text %}
                {%- elsif forloop.index == 2 -%}
                  {% render 'translate', key: 'innovely.how_it_works.step2_text', fallback: block.settings.text %}
                {%- elsif forloop.index == 3 -%}
                  {% render 'translate', key: 'innovely.how_it_works.step3_text', fallback: block.settings.text %}
                {%- else -%}
                  {{ block.settings.text }}
                {%- endif -%}
              </p>
            </article>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom How It Works",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LA MÉTHODE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Comment ça marche"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Une approche en 3 étapes pour rééduquer activement votre posture au quotidien."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Étape 1"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Description de l'étape 1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Analysez votre posture",
            "text": "Placez le capteur dans votre dos. Il calibre automatiquement votre posture idéale en temps réel."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Ressentez la vibration",
            "text": "Dès que vous vous tenez mal, une légère vibration vous rappelle de vous redresser sans douleur."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Musclez votre dos",
            "text": "Jour après jour, vous développez la mémoire musculaire nécessaire pour vous tenir droit sans y penser."
          }
        }
      ]
    }
  ]
}
{% endschema %}
