<section id="top" class="relative overflow-hidden bg-paper">
  <!-- soft ambience -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(55rem 34rem at 88% 18%, rgba(0, 162, 255, 0.08) 0%, transparent 60%), radial-gradient(50rem 38rem at 6% 90%, rgba(0, 82, 255, 0.06) 0%, transparent 60%)"
  ></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-5 pb-20 pt-14 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8 lg:pb-28 lg:pt-24">
    <!-- copy -->
    <div class="max-w-xl">
      <div class="reveal in-view">
        <p class="eyebrow">{% render 'translate', key: 'innovely.hero.eyebrow', fallback: section.settings.eyebrow %}</p>
      </div>

      <div class="reveal in-view" style="transition-delay: 90ms;">
        <h1 class="mt-6 font-display text-[42px] leading-[1.06] tracking-tight sm:text-6xl lg:text-[68px]">
          {% render 'translate', key: 'innovely.hero.title', fallback: section.settings.title %}
        </h1>
      </div>

      <div class="reveal in-view" style="transition-delay: 180ms;">
        <p class="mt-7 max-w-md text-lg leading-relaxed text-muted">{% render 'translate', key: 'innovely.hero.subtitle', fallback: section.settings.subtitle %}</p>
      </div>

      <div class="reveal in-view" style="transition-delay: 260ms;">
        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a
            href="{{ section.settings.cta1_link }}"
            class="group inline-flex items-center justify-center gap-2.5 rounded-full bg-brand px-8 py-4 text-[15px] font-semibold text-paper transition-all duration-300 hover:bg-brand-deep hover:shadow-soft"
          >
            {% render 'translate', key: 'innovely.hero.cta1_label', fallback: section.settings.cta1_label %}
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
          <a
            href="{{ section.settings.cta2_link }}"
            class="group inline-flex items-center justify-center gap-2.5 px-2 py-4 text-[15px] font-medium text-ink"
          >
            {% render 'translate', key: 'innovely.hero.cta2_label', fallback: section.settings.cta2_label %}
            <svg class="h-4 w-4 text-brand transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
        </div>
      </div>

      <div class="reveal in-view" style="transition-delay: 340ms;">
        <ul class="mt-10 flex list-none flex-col gap-2.5 border-t border-line pt-6 text-sm text-muted sm:flex-row sm:gap-8">
          {% for block in section.blocks %}
            <li class="flex items-center gap-2.5">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-brand-soft text-brand">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              {%- if forloop.index == 1 -%}
                {% render 'translate', key: 'innovely.hero.r1_text', fallback: block.settings.text %}
              {%- elsif forloop.index == 2 -%}
                {% render 'translate', key: 'innovely.hero.r2_text', fallback: block.settings.text %}
              {%- elsif forloop.index == 3 -%}
                {% render 'translate', key: 'innovely.hero.r3_text', fallback: block.settings.text %}
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <!-- visual -->
    <div class="reveal in-view relative" style="transition-delay: 200ms;">
      <div class="relative mx-auto max-w-md lg:max-w-none">
        <!-- main photo -->
        <div class="img-zoom relative aspect-[4/5] overflow-hidden rounded-4xl border border-line shadow-soft sm:aspect-[5/5.4]">
          {% if section.settings.image_main != blank %}
            {{ section.settings.image_main | image_url: width: 1000 | image_tag: class: 'h-full w-full object-cover', loading: 'eager' }}
          {% else %}
            <img src="{{ 'hero-posture-before-after.jpg' | asset_url }}" alt="Smart Posture Corrector" width="750" height="939" class="h-full w-full object-cover" loading="eager" />
          {% endif %}
          <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/10 to-transparent"></div>

          <!-- floating device chip -->
          <div class="absolute bottom-5 left-5 right-5 flex items-center justify-between gap-4 rounded-3xl border border-paper/20 bg-ink/65 p-4 backdrop-blur-xl">
            <div>
              <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-paper/60">
                {% render 'translate', key: 'innovely.hero.chip_name', fallback: section.settings.chip_name %}
              </p>
              <p class="mt-1 font-display text-lg text-paper">{% render 'translate', key: 'innovely.hero.chip_tag', fallback: section.settings.chip_tag %}</p>
            </div>
            <!-- icon device SVG -->
            <svg class="h-14 w-24 shrink-0 text-paper" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM11 19.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
          </div>

          <!-- posture chip -->
          <div class="animate-floaty absolute right-4 top-4 rounded-2xl border border-paper/20 bg-paper/90 px-4 py-3 shadow-card backdrop-blur">
            <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-muted">
              {% render 'translate', key: 'innovely.hero.posture_label', fallback: section.settings.posture_label %}
            </p>
            <p class="font-display text-2xl text-ink">{% render 'translate', key: 'innovely.hero.posture_value', fallback: section.settings.posture_value %}</p>
            <div class="mt-1.5 flex items-center gap-1 text-brand">
              {% for i in (1..5) %}
                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              {% endfor %}
            </div>
          </div>

          <!-- result chip -->
          <div
            class="animate-floaty absolute bottom-24 right-4 rounded-2xl border border-paper/20 bg-ink/80 px-4 py-3 shadow-card backdrop-blur"
            style="animation-delay: 0.7s;"
          >
            <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-paper/60">
              {% render 'translate', key: 'innovely.hero.result_label', fallback: section.settings.result_label %}
            </p>
            <p class="text-sm text-paper">{% render 'translate', key: 'innovely.hero.result_value', fallback: section.settings.result_value %}</p>
          </div>
        </div>

        <!-- secondary photo -->
        <div class="absolute -right-5 -top-6 hidden w-36 -rotate-3 overflow-hidden rounded-3xl border-4 border-paper shadow-card lg:block">
          {% if section.settings.image_secondary != blank %}
            {{ section.settings.image_secondary | image_url: width: 400 | image_tag: class: 'aspect-[4/5] w-full object-cover', loading: 'lazy' }}
          {% elsif request.design_mode %}
            {{ 'image' | placeholder_svg_tag: 'aspect-[4/5] w-full object-cover bg-gray-100' }}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CORRECTEUR DE POSTURE INTELLIGENT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Retrouvez une posture parfaite."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Le premier correcteur de posture intelligent qui vous rééduque activement."
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "CTA 1 Label",
      "default": "Découvrir le correcteur de posture intelligent"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "CTA 1 Link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "CTA 2 Label",
      "default": "Comment ça marche"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "CTA 2 Link"
    },
    {
      "type": "image_picker",
      "id": "image_main",
      "label": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "image_secondary",
      "label": "Secondary Image"
    },
    {
      "type": "text",
      "id": "chip_name",
      "label": "Chip Name",
      "default": "DISPOSITIF INTELLIGENT"
    },
    {
      "type": "text",
      "id": "chip_tag",
      "label": "Chip Tag",
      "default": "Correcteur de posture intelligent"
    },
    {
      "type": "text",
      "id": "posture_label",
      "label": "Posture Label",
      "default": "POSTURE"
    },
    {
      "type": "text",
      "id": "posture_value",
      "label": "Posture Value",
      "default": "98%"
    },
    {
      "type": "text",
      "id": "result_label",
      "label": "Result Label",
      "default": "RÉSULTATS"
    },
    {
      "type": "text",
      "id": "result_value",
      "label": "Result Value",
      "default": "Dès 14 jours"
    }
  ],
  "blocks": [
    {
      "type": "reassurance",
      "name": "Reassurance",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Hero",
      "blocks": [
        {
          "type": "reassurance",
          "settings": {
            "text": "Invisible sous les vêtements"
          }
        },
        {
          "type": "reassurance",
          "settings": {
            "text": "Confort garanti 30 jours"
          }
        }
      ]
    }
  ]
}
{% endschema %}
