<section id="faq" data-section-id="{{ section.id }}" style="background-color: #FFFFFF;">
  <div class="mx-auto max-w-3xl px-5 py-24 sm:px-8 lg:py-32">
    <div class="text-center">
      <div class="reveal in-view">
        <p class="eyebrow">{% render 'translate', key: 'innovely.faq.eyebrow', fallback: section.settings.eyebrow %}</p>
      </div>
      <div class="reveal in-view" style="transition-delay: 80ms;">
        <h2 class="mt-6 font-display text-4xl leading-[1.1] tracking-tight sm:text-5xl">
          {% render 'translate', key: 'innovely.faq.title', fallback: section.settings.title %}
        </h2>
      </div>
    </div>

    <div class="mt-14 space-y-3 custom-faq-container">
      {% for block in section.blocks %}
        <div class="reveal in-view" style="transition-delay: {{ forloop.index0 | times: 60 }}ms;">
          <div class="faq-item overflow-hidden rounded-3xl border border-line bg-paper transition-all duration-500">
            <button id="faq-trigger-{{ section.id }}-{{ forloop.index }}" class="faq-trigger flex w-full items-center justify-between gap-6 px-7 py-6 text-left" aria-expanded="false" aria-controls="faq-content-{{ section.id }}-{{ forloop.index }}">
              <span class="font-display text-lg leading-snug text-ink sm:text-xl">
                {%- if forloop.index == 1 -%}
                  {% render 'translate', key: 'innovely.faq.q1_question', fallback: block.settings.question %}
                {%- elsif forloop.index == 2 -%}
                  {% render 'translate', key: 'innovely.faq.q2_question', fallback: block.settings.question %}
                {%- elsif forloop.index == 3 -%}
                  {% render 'translate', key: 'innovely.faq.q3_question', fallback: block.settings.question %}
                {%- elsif forloop.index == 4 -%}
                  {% render 'translate', key: 'innovely.faq.q4_question', fallback: block.settings.question %}
                {%- elsif forloop.index == 5 -%}
                  {% render 'translate', key: 'innovely.faq.q5_question', fallback: block.settings.question %}
                {%- else -%}
                  {{ block.settings.question }}
                {%- endif -%}
              </span>
              <span class="faq-icon inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line text-muted transition-all duration-300">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
              </span>
            </button>
            <div id="faq-content-{{ section.id }}-{{ forloop.index }}" class="faq-content grid transition-[grid-template-rows] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]" role="region" aria-labelledby="faq-trigger-{{ section.id }}-{{ forloop.index }}" style="grid-template-rows: 0fr;">
              <div class="overflow-hidden">
                <p class="px-7 pb-7 leading-relaxed text-muted">
                  {%- if forloop.index == 1 -%}
                    {% render 'translate', key: 'innovely.faq.q1_answer', fallback: block.settings.answer %}
                  {%- elsif forloop.index == 2 -%}
                    {% render 'translate', key: 'innovely.faq.q2_answer', fallback: block.settings.answer %}
                  {%- elsif forloop.index == 3 -%}
                    {% render 'translate', key: 'innovely.faq.q3_answer', fallback: block.settings.answer %}
                  {%- elsif forloop.index == 4 -%}
                    {% render 'translate', key: 'innovely.faq.q4_answer', fallback: block.settings.answer %}
                  {%- elsif forloop.index == 5 -%}
                    {% render 'translate', key: 'innovely.faq.q5_answer', fallback: block.settings.answer %}
                  {%- else -%}
                    {{ block.settings.answer }}
                  {%- endif -%}
                </p>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sectionEl = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!sectionEl) return;
    const faqContainer = sectionEl.querySelector('.custom-faq-container');
    if (!faqContainer) return;

    const items = faqContainer.querySelectorAll('.faq-item');
    
    items.forEach(item => {
      const trigger = item.querySelector('.faq-trigger');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon');
      
      trigger.addEventListener('click', () => {
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
        
        // Close all
        items.forEach(otherItem => {
          otherItem.querySelector('.faq-trigger').setAttribute('aria-expanded', 'false');
          otherItem.querySelector('.faq-content').style.gridTemplateRows = '0fr';
          otherItem.classList.remove('border-brand/30', 'shadow-card');
          otherItem.classList.add('border-line');
          
          const otherIcon = otherItem.querySelector('.faq-icon');
          otherIcon.classList.remove('rotate-45', 'border-brand', 'bg-brand', 'text-paper');
          otherIcon.classList.add('border-line', 'text-muted');
        });
        
        // Open clicked if it wasn't already open
        if (!isExpanded) {
          trigger.setAttribute('aria-expanded', 'true');
          content.style.gridTemplateRows = '1fr';
          item.classList.remove('border-line');
          item.classList.add('border-brand/30', 'shadow-card');
          
          icon.classList.remove('border-line', 'text-muted');
          icon.classList.add('rotate-45', 'border-brand', 'bg-brand', 'text-paper');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Custom FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Questions fréquentes"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Comment ça marche ?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Voici la réponse."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom FAQ",
      "blocks": [
        {
          "type": "faq_item"
        },
        {
          "type": "faq_item"
        },
        {
          "type": "faq_item"
        }
      ]
    }
  ]
}
{% endschema %}
