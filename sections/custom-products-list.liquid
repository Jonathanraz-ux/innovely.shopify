{%- liquid
  # Resolve products to show
  assign products_to_show = section.settings.product_list
  if products_to_show == blank and section.settings.collection != blank
    assign products_to_show = section.settings.collection.products
  endif

  if products_to_show == blank
    # fallback to all products if both are empty
    assign products_to_show = collections.all.products
  endif

  assign limit = section.settings.max_products | default: 4
  assign cols_desktop = section.settings.columns_desktop | default: 3
-%}

<section id="custom-products" class="{{ section.settings.background_color }}">
  <style>
    /* Use a custom class instead of `.grid` to avoid base.css's
       14-column grid-template-areas override. */
    #custom-products .products-grid {
      display: grid;
      gap: 2rem;
      grid-template-columns: 1fr;
    }
    @media screen and (min-width: 750px) {
      #custom-products .products-grid {
        grid-template-columns: repeat(var(--products-cols, 3), minmax(0, 1fr));
      }
    }
  </style>
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center mb-16">
      <div class="reveal in-view">
        <p class="eyebrow">{% render 'translate', key: 'innovely.products_list.eyebrow', fallback: section.settings.eyebrow %}</p>
      </div>
      <div class="reveal in-view" style="transition-delay: 80ms;">
        <h2 class="mt-6 font-display text-4xl leading-[1.1] tracking-tight sm:text-5xl">
          {% render 'translate', key: 'innovely.products_list.title', fallback: section.settings.title %}
        </h2>
      </div>
    </div>

    <!-- Grid Container -->
    {%- if products_to_show != blank and products_to_show.size > 0 -%}

      <div class="products-grid justify-center max-w-7xl mx-auto" style="--products-cols: {{ cols_desktop }};">
        {%- for product in products_to_show limit: limit -%}
          <div class="reveal in-view flex" style="transition-delay: {{ forloop.index0 | times: 100 }}ms;">
            <article class="group relative flex w-full flex-col justify-between overflow-hidden rounded-2xl border border-line bg-paper shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft">
              <!-- Image Gallery Wrapper -->
              <div class="relative aspect-square w-full overflow-hidden bg-ink-soft/5">
                {%- if product.featured_media != blank -%}
                  <img 
                    src="{{ product.featured_media | image_url: width: 600 }}" 
                    alt="{{ product.title | escape }}" 
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" 
                    loading="lazy" 
                  />
                  {%- if product.images[1] != blank -%}
                    <img 
                      src="{{ product.images[1] | image_url: width: 600 }}" 
                      alt="{{ product.title | escape }}" 
                      class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 group-hover:opacity-100 group-hover:scale-105" 
                      loading="lazy" 
                    />
                  {%- endif -%}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'h-full w-full object-cover bg-gray-100' }}
                {%- endif -%}

                <!-- Badges -->
                <div class="absolute left-4 top-4 flex flex-col gap-2">
                  {%- if product.available == false -%}
                    <span class="rounded-full bg-ink/75 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-paper backdrop-blur-sm">
                      {% render 'translate', key: 'innovely.products_list.sold_out_badge', fallback: section.settings.sold_out_badge_label %}
                    </span>
                  {%- elsif product.price < 5799 -%}
                    {%- assign pct_off = 5799 | minus: product.price | times: 100.0 | divided_by: 5799 | round -%}
                    <span class="rounded-full bg-brand px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-paper">
                      -{{ pct_off }}%
                    </span>
                  {%- endif -%}
                </div>
              </div>

              <!-- Product Details -->
              <div class="flex flex-1 flex-col p-4">
                <!-- Stars & Reviews -->
                <div class="flex items-center gap-0.5 text-brand mb-1.5">
                  {%- for i in (1..5) -%}
                    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  {%- endfor -%}
                  <span class="text-[10px] font-semibold text-muted ml-0.5">5.0</span>
                </div>

                <!-- Title -->
                <h3 class="font-display text-base leading-snug text-ink mb-1">
                  <a href="{{ product.url }}" class="hover:text-brand transition-colors duration-200">
                    {{ product.title }}
                  </a>
                </h3>

                <!-- Description Sneak-peak -->
                <p style="display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;text-overflow:ellipsis;" class="text-xs leading-relaxed text-muted mb-4 flex-1">
                  {{ product.description | strip_html | split: 'Votre navigateur' | first | strip }}
                </p>

                <!-- Footer details (Price & CTA) -->
                <div class="flex items-center justify-between border-t border-line pt-3 mt-auto">
                  <div class="flex flex-col">
                    {%- if product.price < 5799 -%}
                      <span class="text-[10px] text-muted line-through">{{ 5799 | money }}</span>
                    {%- endif -%}
                    <span class="font-display text-base font-bold text-ink">{{ product.price | money }}</span>
                  </div>

                  <a 
                    href="{{ product.url }}" 
                    class="rounded-full bg-ink px-4 py-1.5 text-[10px] font-semibold text-paper hover:bg-brand hover:text-paper transition-all duration-300"
                  >
                    {%- if product.available -%}
                      {% render 'translate', key: 'innovely.products_list.discover', fallback: section.settings.discover_button_label %}
                    {%- else -%}
                      {% render 'translate', key: 'innovely.products_list.view', fallback: section.settings.view_button_label %}
                    {%- endif -%}
                  </a>
                </div>
              </div>
            </article>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <!-- Onboarding state if no products -->
      <div class="text-center py-12 text-muted">
        <p>No products to display. Please configure this section in the theme editor.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom Products List",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR PRODUCTS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Discover our range"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "info": "Manually select products to display. If empty, falls back to the selected collection."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Background color",
      "options": [
        {
          "value": "bg-paper",
          "label": "White"
        },
        {
          "value": "bg-paper-deep/60",
          "label": "Light gray"
        },
        {
          "value": "bg-ink text-paper grain",
          "label": "Dark (grain)"
        }
      ],
      "default": "bg-paper"
    },
    {
      "type": "header",
      "content": "Translations fallback"
    },
    {
      "type": "text",
      "id": "discover_button_label",
      "label": "Discover button label",
      "default": "Discover"
    },
    {
      "type": "text",
      "id": "view_button_label",
      "label": "View button label",
      "default": "View"
    },
    {
      "type": "text",
      "id": "sold_out_badge_label",
      "label": "Sold out badge label",
      "default": "Sold out"
    }
  ],
  "presets": [
    {
      "name": "Custom Products List"
    }
  ]
}
{% endschema %}
