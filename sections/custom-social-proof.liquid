<section id="avis" class="text-white" style="background-color: #0035cc;">
  <style>
    #avis {
      --sp-gap: 24px;
      --sp-per-view: 1;
    }

    @media (min-width: 640px) {
      #avis {
        --sp-per-view: 2;
      }
    }

    @media (min-width: 1024px) {
      #avis {
        --sp-per-view: 3;
      }
    }

    #avis .sp-carousel {
      width: 100%;
      position: relative;
    }

    #avis .sp-carousel__viewport {
      width: 100%;
      min-width: 0;
      overflow: hidden;
      touch-action: pan-y;
      scrollbar-width: none;
      -ms-overflow-style: none;
      border-radius: 2rem;
      user-select: none;
      -webkit-user-select: none;
    }

    #avis .sp-carousel__viewport::-webkit-scrollbar {
      display: none;
    }

    #avis .sp-carousel__track {
      display: flex;
      align-items: stretch;
      gap: var(--sp-gap);
      will-change: transform;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    #avis .sp-carousel__track::-webkit-scrollbar {
      display: none;
    }

    #avis .sp-carousel__slide {
      flex: 0 0 var(--sp-slide-w, calc((100% - (var(--sp-per-view) - 1) * var(--sp-gap)) / var(--sp-per-view)));
      width: var(--sp-slide-w, calc((100% - (var(--sp-per-view) - 1) * var(--sp-gap)) / var(--sp-per-view)));
      max-width: var(--sp-slide-w, calc((100% - (var(--sp-per-view) - 1) * var(--sp-gap)) / var(--sp-per-view)));
      min-width: 0;
      box-sizing: border-box;
    }

    #avis .sp-carousel__slide > figure {
      height: 100%;
      margin: 0;
    }

    #avis .sp-carousel__nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      margin-top: 2.25rem;
      position: relative;
      z-index: 10;
    }

    #avis .sp-carousel__arrow {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      width: 3.25rem;
      height: 3.25rem;
      padding: 0;
      border-radius: 9999px;
      border: 1px solid rgba(255, 255, 255, 0.4);
      background-color: #ffffff;
      color: #0035cc;
      box-shadow: 0 8px 22px rgba(0, 20, 80, 0.25);
      cursor: pointer;
      pointer-events: auto;
      position: relative;
      z-index: 20;
      transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
      -webkit-tap-highlight-color: transparent;
    }

    #avis .sp-carousel__arrow:hover {
      background-color: #f0f4ff;
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(0, 20, 80, 0.3);
    }

    #avis .sp-carousel__arrow:active {
      transform: scale(0.95);
    }

    #avis .sp-carousel__arrow:focus-visible {
      outline: 3px solid #ffffff;
      outline-offset: 3px;
    }

    #avis .sp-carousel__arrow svg {
      width: 1.35rem;
      height: 1.35rem;
      pointer-events: none;
    }
  </style>
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
    <div class="mx-auto max-w-2xl text-center">
      <div class="reveal in-view">
        <p class="eyebrow !text-white">{% render 'translate', key: 'innovely.social_proof.eyebrow', fallback: section.settings.eyebrow %}</p>
      </div>
      <div class="reveal in-view" style="transition-delay: 80ms;">
        <h2 class="mt-6 font-display text-4xl leading-[1.1] tracking-tight sm:text-5xl">
          {% render 'translate', key: 'innovely.social_proof.title', fallback: section.settings.title %}
        </h2>
      </div>
    </div>

    <!-- stats band -->
    {%- if section.settings.show_stats -%}
      <div class="reveal in-view" style="transition-delay: 120ms;">
        <div class="mt-16 grid gap-px overflow-hidden rounded-4xl border border-white/20 bg-white/20 sm:grid-cols-3">
          {% for i in (1..3) %}
            {% assign stat_val = 'stat' | append: i | append: '_val' %}
            {% assign stat_label = 'stat' | append: i | append: '_label' %}
            <div class="bg-white px-8 py-10 text-center">
              <p class="font-display text-5xl tracking-tight text-[#0035cc]">{{ section.settings[stat_val] }}</p>
              <p class="mx-auto mt-3 max-w-[26ch] text-sm leading-relaxed text-[#0035cc]">
                {%- if i == 1 -%}
                  {% render 'translate', key: 'innovely.social_proof.stat1_label', fallback: section.settings[stat_label] %}
                {%- elsif i == 2 -%}
                  {% render 'translate', key: 'innovely.social_proof.stat2_label', fallback: section.settings[stat_label] %}
                {%- elsif i == 3 -%}
                  {% render 'translate', key: 'innovely.social_proof.stat3_label', fallback: section.settings[stat_label] %}
                {%- endif -%}
              </p>
            </div>
          {% endfor %}
        </div>
      </div>
    {%- endif -%}

    <!-- reviews carousel -->
    <div class="mt-12">
      <div class="reveal in-view" style="transition-delay: 120ms;">
        <div class="sp-carousel" data-sp-carousel>
          <div
            class="sp-carousel__viewport"
            tabindex="0"
            role="group"
            aria-roledescription="carousel"
            aria-label="{% render 'translate', key: 'innovely.social_proof.carousel_label', fallback: 'Customer testimonials' %}"
          >
            <div class="sp-carousel__track">
              {% assign rev_total = section.blocks | where: 'type', 'review' | size %}
              {% assign rev_count = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'review' %}
                  {% assign rev_count = rev_count | plus: 1 %}
                  {% assign rev_text_key = 'innovely.social_proof.rev' | append: rev_count | append: '_text' %}
                  {% assign rev_meta_key = 'innovely.social_proof.rev' | append: rev_count | append: '_meta' %}
                  <div class="sp-carousel__slide" role="group" aria-roledescription="slide" aria-label="{{ block.settings.name }} · {{ rev_count }} / {{ rev_total }}">
                    <figure class="flex h-full flex-col rounded-4xl border border-white/20 bg-white p-8 shadow-card">
                      <div class="flex items-center gap-1.5 text-brand" aria-label="{% render 'translate', key: 'innovely.social_proof.stars_aria', fallback: '5 stars' %}">
                        {% for j in (1..5) %}
                          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        {% endfor %}
                      </div>
                      <blockquote class="mt-6 flex-1 leading-relaxed text-ink-soft">&ldquo;{% render 'translate', key: rev_text_key, fallback: block.settings.text %}&rdquo;</blockquote>
                      <figcaption class="mt-8 border-t border-line pt-6">
                        <p class="text-sm font-semibold text-ink">{{ block.settings.name }}</p>
                        {% if block.settings.meta != blank %}
                          <p class="mt-1 text-xs text-muted">{% render 'translate', key: rev_meta_key, fallback: block.settings.meta %}</p>
                        {% endif %}
                      </figcaption>
                    </figure>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <div class="sp-carousel__nav">
            <button
              type="button"
              class="sp-carousel__arrow sp-carousel__arrow--prev"
              aria-label="{% render 'translate', key: 'innovely.social_proof.carousel_prev', fallback: 'Previous testimonial' %}"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
            </button>
            <button
              type="button"
              class="sp-carousel__arrow sp-carousel__arrow--next"
              aria-label="{% render 'translate', key: 'innovely.social_proof.carousel_next', fallback: 'Next testimonial' %}"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- UGC gallery -->
    <div class="mt-24">
      <div class="reveal in-view">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">{% render 'translate', key: 'innovely.social_proof.ugc_eyebrow', fallback: section.settings.ugc_eyebrow %}</p>
            <h3 class="mt-4 font-display text-3xl leading-tight tracking-tight sm:text-4xl">
              {% render 'translate', key: 'innovely.social_proof.ugc_title', fallback: section.settings.ugc_title %}
            </h3>
          </div>

        </div>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6">
        {% assign ugc_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'ugc' %}
            {% assign ugc_count = ugc_count | plus: 1 %}
            {% assign default_img_name = 'ugc-' | append: ugc_count | append: '.jpg' %}
            <div class="reveal in-view" style="transition-delay: {{ forloop.index0 | times: 80 }}ms;" {{ block.shopify_attributes }}>
              <figure class="group relative aspect-square overflow-hidden rounded-3xl">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | default: section.settings.ugc_title | escape }}" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                {% else %}
                  <img src="{{ default_img_name | asset_url }}" alt="{{ section.settings.ugc_title | escape }}" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                {% endif %}
              </figure>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    function initCarousels() {
      var carousels = document.querySelectorAll('[data-sp-carousel]');
      for (var i = 0; i < carousels.length; i++) {
        setupCarousel(carousels[i]);
      }
    }

    function setupCarousel(carousel) {
      if (carousel.getAttribute('data-sp-ready') === 'true') return;
      carousel.setAttribute('data-sp-ready', 'true');

      var viewport = carousel.querySelector('.sp-carousel__viewport');
      var track = carousel.querySelector('.sp-carousel__track');
      var prevBtn = carousel.querySelector('.sp-carousel__arrow--prev');
      var nextBtn = carousel.querySelector('.sp-carousel__arrow--next');
      if (!viewport || !track) return;

      var rawSlides = track.querySelectorAll('.sp-carousel__slide');
      var originals = [];
      for (var k = 0; k < rawSlides.length; k++) {
        originals.push(rawSlides[k].cloneNode(true));
      }

      var total = originals.length;
      if (total < 2) {
        var nav = carousel.querySelector('.sp-carousel__nav');
        if (nav) nav.style.display = 'none';
        return;
      }

      var GAP = 24;
      var perView = 1;
      var slideW = 0;
      var step = 0;
      var clones = 6;
      var pos = 0;
      var dragging = false;
      var dragStartX = 0;
      var dragDelta = 0;
      var snapTimer = null;
      var unlockTimer = null;
      var isMoving = false;

      function getPerView() {
        var w = window.innerWidth;
        if (w < 640) return 1;
        if (w < 1024) return 2;
        return 3;
      }

      function computeDimensions() {
        perView = getPerView();
        clones = Math.max(perView + 3, 6);
        var vw = viewport.getBoundingClientRect().width;
        if (!vw || vw <= 0) vw = viewport.clientWidth || 360;
        slideW = (vw - (perView - 1) * GAP) / perView;
        if (!isFinite(slideW) || slideW < 1) slideW = vw;
        step = slideW + GAP;
        carousel.style.setProperty('--sp-slide-w', slideW + 'px');
        track.style.setProperty('--sp-slide-w', slideW + 'px');
      }

      function setTransform(px, animate) {
        if (animate) {
          track.style.transition = 'transform 450ms cubic-bezier(0.22, 1, 0.36, 1)';
        } else {
          track.style.transition = 'none';
        }
        track.style.transform = 'translate3d(' + px + 'px, 0, 0)';
      }

      function normalizePos() {
        var minPos = clones;
        var maxPos = clones + total - 1;
        if (pos > maxPos || pos < minPos) {
          var offset = ((pos - minPos) % total + total) % total;
          pos = minPos + offset;
          setTransform(-pos * step, false);
        }
      }

      function makeClone(src) {
        var clone = src.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        return clone;
      }

      function rebuild() {
        computeDimensions();
        var fragL = document.createDocumentFragment();
        var fragR = document.createDocumentFragment();

        for (var m = 0; m < clones; m++) {
          var srcIdx = ((total - clones + m) % total + total) % total;
          fragL.appendChild(makeClone(originals[srcIdx]));
        }
        for (var n = 0; n < clones; n++) {
          fragR.appendChild(makeClone(originals[n % total]));
        }

        track.innerHTML = '';
        track.appendChild(fragL);
        for (var o = 0; o < originals.length; o++) {
          var origNode = originals[o].cloneNode(true);
          origNode.removeAttribute('aria-hidden');
          track.appendChild(origNode);
        }
        track.appendChild(fragR);

        pos = clones;
        setTransform(-pos * step, false);
      }

      function go(delta) {
        if (isMoving) return;
        isMoving = true;
        normalizePos();
        pos += delta;
        setTransform(-pos * step, true);

        if (snapTimer) clearTimeout(snapTimer);
        snapTimer = setTimeout(function () {
          normalizePos();
          isMoving = false;
        }, 480);

        if (unlockTimer) clearTimeout(unlockTimer);
        unlockTimer = setTimeout(function () {
          isMoving = false;
        }, 500);
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          go(-1);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          go(1);
        });
      }

      carousel.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          go(-1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          go(1);
        }
      });

      viewport.addEventListener('pointerdown', function (e) {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        if (snapTimer) clearTimeout(snapTimer);
        normalizePos();
        isMoving = false;
        dragging = true;
        dragStartX = e.clientX;
        dragDelta = 0;
        track.style.transition = 'none';
        track.style.userSelect = 'none';
        if (viewport.setPointerCapture) {
          try { viewport.setPointerCapture(e.pointerId); } catch (err) {}
        }
      });

      viewport.addEventListener('pointermove', function (e) {
        if (!dragging) return;
        dragDelta = e.clientX - dragStartX;
        track.style.transform = 'translate3d(' + (dragDelta - pos * step) + 'px, 0, 0)';
      });

      function dragEnd() {
        if (!dragging) return;
        dragging = false;
        track.style.userSelect = '';
        var deltaIndex = Math.round(-dragDelta / step);
        if (deltaIndex === 0 && Math.abs(dragDelta) > Math.min(50, slideW * 0.2)) {
          deltaIndex = dragDelta < 0 ? 1 : -1;
        }
        pos += deltaIndex;
        setTransform(-pos * step, true);
        if (snapTimer) clearTimeout(snapTimer);
        snapTimer = setTimeout(function () {
          normalizePos();
          isMoving = false;
        }, 480);
      }

      viewport.addEventListener('pointerup', dragEnd);
      viewport.addEventListener('pointercancel', dragEnd);

      viewport.addEventListener('click', function (e) {
        if (Math.abs(dragDelta) > 8) e.preventDefault();
      });

      track.addEventListener('transitionend', function (evt) {
        if (evt.target !== track || evt.propertyName !== 'transform') return;
        normalizePos();
        isMoving = false;
      });

      rebuild();

      if (window.ResizeObserver) {
        var ro = new ResizeObserver(function () {
          var oldPerView = perView;
          if (getPerView() !== oldPerView) {
            rebuild();
          } else {
            computeDimensions();
            setTransform(-pos * step, false);
          }
        });
        ro.observe(viewport);
      } else {
        var resizeTimer = null;
        window.addEventListener('resize', function () {
          if (resizeTimer) clearTimeout(resizeTimer);
          resizeTimer = setTimeout(function () {
            var oldPerView = perView;
            if (getPerView() !== oldPerView) {
              rebuild();
            } else {
              computeDimensions();
              setTransform(-pos * step, false);
            }
          }, 150);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCarousels);
    } else {
      initCarousels();
    }
    document.addEventListener('shopify:section:load', initCarousels);
  })();
</script>

