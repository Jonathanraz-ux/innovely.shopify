<section id="avis" class="bg-paper">
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
    <div class="mx-auto max-w-2xl text-center">
      <div class="reveal in-view">
        <p class="eyebrow">{{ 'innovely.social_proof.eyebrow' | t | default: section.settings.eyebrow }}</p>
      </div>
      <div class="reveal in-view" style="transition-delay: 80ms;">
        <h2 class="mt-6 font-display text-4xl leading-[1.1] tracking-tight sm:text-5xl">
          {{ 'innovely.social_proof.title' | t | default: section.settings.title }}
        </h2>
      </div>
    </div>

    <!-- stats band -->
    <div class="reveal in-view" style="transition-delay: 120ms;">
      <div class="mt-16 grid gap-px overflow-hidden rounded-4xl border border-line bg-line sm:grid-cols-3">
        {% for i in (1..3) %}
          {% assign stat_val = 'stat' | append: i | append: '_val' %}
          {% assign stat_label = 'stat' | append: i | append: '_label' %}
          {% assign stat_t_key = 'innovely.social_proof.stat' | append: i | append: '_label' %}
          <div class="bg-paper px-8 py-10 text-center">
            <p class="font-display text-5xl tracking-tight text-ink">{{ section.settings[stat_val] }}</p>
            <p class="mx-auto mt-3 max-w-[26ch] text-sm leading-relaxed text-muted">{{ stat_t_key | t | default: section.settings[stat_label] }}</p>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- reviews -->
    <div class="mt-6 grid gap-6 lg:grid-cols-3">
      {% assign rev_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          {% assign rev_count = rev_count | plus: 1 %}
          {% assign rev_text_key = 'innovely.social_proof.rev' | append: rev_count | append: '_text' %}
          {% assign rev_meta_key = 'innovely.social_proof.rev' | append: rev_count | append: '_meta' %}
          <div class="reveal in-view" style="transition-delay: {{ forloop.index0 | times: 120 }}ms;">
            <figure class="flex h-full flex-col rounded-4xl border border-line bg-paper p-8 shadow-card">
              <div class="flex items-center gap-1.5 text-brand" aria-label="{{ 'innovely.social_proof.stars_aria' | t }}">
                {% for j in (1..5) %}
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                {% endfor %}
              </div>
              <blockquote class="mt-6 flex-1 leading-relaxed text-ink-soft">« {{ rev_text_key | t | default: block.settings.text }} »</blockquote>
              <figcaption class="mt-8 flex items-center gap-4 border-t border-line pt-6">
                <span class="h-11 w-11 shrink-0 overflow-hidden rounded-full">
                  {% if block.settings.photo != blank %}
                    <img src="{{ block.settings.photo | image_url: width: 100 }}" alt="{{ block.settings.name }}" class="h-full w-full object-cover" loading="lazy" />
                  {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 17" fill="none" class="h-full w-full bg-gray-100 text-ink-soft" aria-hidden="true">
                      <path stroke="currentColor" stroke-linejoin="round" stroke-width="1.5" d="M10.375 3.813a3.063 3.063 0 1 1-6.125 0 3.063 3.063 0 0 1 6.125 0ZM7.313 9.5c-3.667 0-6.24 2.691-6.563 6.125h13.125C13.552 12.191 10.979 9.5 7.312 9.5Z" />
                    </svg>
                  {% endif %}
                </span>
                <div>
                  <p class="text-sm font-semibold text-ink">{{ block.settings.name }}</p>
                  <p class="text-xs text-muted">{{ rev_meta_key | t | default: block.settings.meta }}</p>
                </div>
              </figcaption>
            </figure>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- UGC gallery -->
    <div class="mt-24">
      <div class="reveal in-view">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">{{ 'innovely.social_proof.ugc_eyebrow' | t | default: section.settings.ugc_eyebrow }}</p>
            <h3 class="mt-4 font-display text-3xl leading-tight tracking-tight sm:text-4xl">
              {{ 'innovely.social_proof.ugc_title' | t | default: section.settings.ugc_title }}
            </h3>
          </div>
          <a href="#" class="group inline-flex items-center gap-2.5 text-sm font-medium text-ink transition-colors hover:text-brand">
            <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            @innovely
            <span class="link-underline">{{ 'innovely.social_proof.view_more' | t }}</span>
          </a>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6">
        {% assign ugc_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'ugc' %}
            {% assign ugc_count = ugc_count | plus: 1 %}
            {% assign ugc_tag_key = 'innovely.social_proof.u' | append: ugc_count | append: '_tag' %}
            <div class="reveal in-view" style="transition-delay: {{ forloop.index0 | times: 80 }}ms;">
              <figure class="group relative aspect-square overflow-hidden rounded-3xl">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.tag }}" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'h-full w-full object-cover transition-transform duration-700 group-hover:scale-110 bg-gray-100' }}
                {% endif %}
                <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
                <figcaption class="absolute inset-x-0 bottom-0 translate-y-3 p-4 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
                  <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-paper/70">{{ ugc_tag_key | t | default: block.settings.tag }}</p>
                  <p class="mt-0.5 text-sm font-semibold text-paper">{{ block.settings.name }}</p>
                </figcaption>
              </figure>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Social Proof",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NOTRE COMMUNAUTÉ"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Ils ont redressé la barre."
    },
    {
      "type": "text",
      "id": "stat1_val",
      "label": "Stat 1 Value",
      "default": "+50k"
    },
    {
      "type": "text",
      "id": "stat1_label",
      "label": "Stat 1 Label",
      "default": "utilisateurs quotidiens"
    },
    {
      "type": "text",
      "id": "stat2_val",
      "label": "Stat 2 Value",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Stat 2 Label",
      "default": "note moyenne sur Trustpilot"
    },
    {
      "type": "text",
      "id": "stat3_val",
      "label": "Stat 3 Value",
      "default": "92%"
    },
    {
      "type": "text",
      "id": "stat3_label",
      "label": "Stat 3 Label",
      "default": "ressentent moins de douleurs"
    },
    {
      "type": "text",
      "id": "ugc_eyebrow",
      "label": "UGC Eyebrow",
      "default": "SUR INSTAGRAM"
    },
    {
      "type": "text",
      "id": "ugc_title",
      "label": "UGC Title",
      "default": "Partout avec vous."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Camille M."
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta Info",
          "default": "Utilise Innovely depuis 3 mois"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Je ne peux plus m'en passer."
        }
      ]
    },
    {
      "type": "ugc",
      "name": "UGC Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Au bureau"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Username",
          "default": "@camille.m"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Social Proof",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "ugc" },
        { "type": "ugc" },
        { "type": "ugc" },
        { "type": "ugc" },
        { "type": "ugc" },
        { "type": "ugc" }
      ]
    }
  ]
}
{% endschema %}
