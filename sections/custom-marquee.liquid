<section class="relative overflow-hidden border-y border-line bg-paper py-5" aria-hidden="true">
  <div class="animate-marquee flex w-max items-center gap-10 whitespace-nowrap">
    {% for i in (1..2) %}
      {% for block in section.blocks %}
        {% assign m_key = 'innovely.marquee.m' | append: forloop.index | append: '_text' %}
        <span class="flex items-center gap-10">
          <span class="text-sm font-medium uppercase tracking-[0.18em] text-muted">{% render 'translate', key: m_key, fallback: block.settings.text %}</span>
          <span class="h-1.5 w-1.5 rounded-full bg-brand/50"></span>
        </span>
      {% endfor %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Custom Marquee",
  "settings": [],
  "blocks": [
    {
      "type": "marquee_item",
      "name": "Marquee Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Thoughtfully Designed"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Marquee",
      "blocks": [
        { "type": "marquee_item", "settings": { "text": "Thoughtfully Designed" } },
        { "type": "marquee_item", "settings": { "text": "Medical-Grade Silicone" } },
        { "type": "marquee_item", "settings": { "text": "USB-C Rechargeable" } },
        { "type": "marquee_item", "settings": { "text": "2-Year Warranty" } },
        { "type": "marquee_item", "settings": { "text": "Discreet & Lightweight" } },
        { "type": "marquee_item", "settings": { "text": "For Adults & Kids" } },
        { "type": "marquee_item", "settings": { "text": "Free Shipping" } },
        { "type": "marquee_item", "settings": { "text": "30-Day Money-Back Guarantee" } }
      ]
    }
  ]
}
{% endschema %}
