<section class="promo-scroll-bar" aria-label="{% render 'translate', key: 'innovely.promo_bar.aria_label', fallback: 'Promotion' %}">
  {%- liquid
    assign promo_product_handle = 'oem-adjustable-back-brace-straightening-detection-reminder-spine-vibrates-smart-posture-corrector'
    assign promo_product = all_products[promo_product_handle]
    assign promo_product_url = promo_product.url
    if promo_product_url == blank
      assign promo_product_url = routes.root_url | append: 'products/' | append: promo_product_handle
    endif
  -%}
  <div class="promo-scroll-bar__viewport">
    <div class="promo-scroll-bar__track">
      {% for i in (1..2) %}
        <div class="promo-scroll-bar__group"{% if i == 2 %} aria-hidden="true"{% endif %}>
          {% for j in (1..8) %}
            <span class="promo-scroll-bar__item">
              <span class="promo-scroll-bar__message">
                <strong class="promo-scroll-bar__highlight">{% render 'translate', key: 'innovely.promo_bar.highlight', fallback: '48% OFF' %}</strong>
                {% render 'translate', key: 'innovely.promo_bar.message', fallback: 'your posture corrector · Limited offer —' %}
                <a href="{{ promo_product_url }}" class="promo-scroll-bar__link">{% render 'translate', key: 'innovely.promo_bar.cta', fallback: 'Shop now →' %}</a>
              </span>
              <span class="promo-scroll-bar__sep" aria-hidden="true">•</span>
            </span>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .promo-scroll-bar {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background-color: var(--color-brand);
    color: var(--color-paper);
  }

  .promo-scroll-bar__viewport {
    overflow: hidden;
    width: 100%;
    max-width: 100%;
  }

  .promo-scroll-bar__track {
    display: flex;
    width: max-content;
    animation: promo-scroll-bar-move 45s linear infinite;
  }

  .promo-scroll-bar:hover .promo-scroll-bar__track,
  .promo-scroll-bar:focus-within .promo-scroll-bar__track {
    animation-play-state: paused;
  }

  .promo-scroll-bar__group {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .promo-scroll-bar__item {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    padding: 10px 0;
    white-space: nowrap;
  }

  .promo-scroll-bar__message {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.35;
    white-space: nowrap;
  }

  .promo-scroll-bar__highlight {
    font-weight: 700;
  }

  .promo-scroll-bar__link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .promo-scroll-bar__link:hover,
  .promo-scroll-bar__link:focus-visible {
    text-decoration-thickness: 2px;
  }

  .promo-scroll-bar__sep {
    display: inline-block;
    margin: 0 22px;
    font-size: 12px;
    line-height: 1;
    opacity: 0.55;
  }

  @keyframes promo-scroll-bar-move {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (min-width: 750px) {
    .promo-scroll-bar__item {
      padding: 11px 0;
    }

    .promo-scroll-bar__message,
    .promo-scroll-bar__sep {
      font-size: 13px;
      letter-spacing: 0.035em;
    }
  }

  @media (max-width: 749px) {
    .promo-scroll-bar__item {
      padding: 9px 0;
    }

    .promo-scroll-bar__message,
    .promo-scroll-bar__sep {
      font-size: 11px;
      letter-spacing: 0.02em;
    }

    .promo-scroll-bar__sep {
      margin: 0 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .promo-scroll-bar__track {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "Promo Bar",
  "settings": [],
  "presets": [
    { "name": "Promo Bar" }
  ]
}
{% endschema %}
