<section class="promo-scroll-bar" aria-label="Promotion">
  <div class="promo-scroll-bar__viewport">
    <div class="promo-scroll-bar__track">
      {% for i in (1..2) %}
        <div class="promo-scroll-bar__group"{% if i == 2 %} aria-hidden="true"{% endif %}>
          {% for j in (1..8) %}
            <span class="promo-scroll-bar__item">
              <span class="promo-scroll-bar__text">{% render 'translate', key: 'innovely.promo_bar.text', fallback: 'PROMOTION : -48% • LIMITED OFFER' %}</span>
              <span class="promo-scroll-bar__dot" aria-hidden="true"></span>
            </span>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .promo-scroll-bar {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-brand);
    color: var(--color-paper);
  }

  .promo-scroll-bar__viewport {
    overflow: hidden;
    width: 100%;
  }

  .promo-scroll-bar__track {
    display: flex;
    width: max-content;
    animation: promo-scroll-bar-move 32s linear infinite;
  }

  .promo-scroll-bar__group {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .promo-scroll-bar__item {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    padding: 9px 0;
    white-space: nowrap;
  }

  .promo-scroll-bar__text {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1;
  }

  .promo-scroll-bar__dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    margin: 0 22px;
    border-radius: 9999px;
    background-color: currentColor;
    opacity: 0.55;
  }

  @keyframes promo-scroll-bar-move {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (min-width: 750px) {
    .promo-scroll-bar__text {
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .promo-scroll-bar__track {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "Promo Scroll Bar",
  "settings": [],
  "presets": [
    { "name": "Promo Scroll Bar" }
  ]
}
{% endschema %}
