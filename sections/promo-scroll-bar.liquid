<section class="promo-scroll-bar" aria-label="{% render 'translate', key: 'innovely.promo_bar.aria_label', fallback: 'Promotion' %}">
  {%- liquid
    assign promo_product_handle = 'oem-adjustable-back-brace-straightening-detection-reminder-spine-vibrates-smart-posture-corrector'
    assign promo_product = all_products[promo_product_handle]
    assign promo_product_url = promo_product.url
    if promo_product_url == blank
      assign promo_product_url = routes.root_url | append: 'products/' | append: promo_product_handle
    endif
  -%}
  <p class="promo-scroll-bar__text">
    <strong class="promo-scroll-bar__highlight">{% render 'translate', key: 'innovely.promo_bar.highlight', fallback: '48% OFF' %}</strong>
    {% render 'translate', key: 'innovely.promo_bar.message', fallback: 'your posture corrector · Limited offer —' %}
    <a href="{{ promo_product_url }}" class="promo-scroll-bar__link">{% render 'translate', key: 'innovely.promo_bar.cta', fallback: 'Shop now →' %}</a>
  </p>
</section>

<style>
  .promo-scroll-bar {
    display: flex;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
    padding: 10px 16px;
    background-color: var(--color-brand);
    color: var(--color-paper);
    text-align: center;
    overflow: hidden;
  }

  .promo-scroll-bar__text {
    margin: 0;
    max-width: 100%;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.35;
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .promo-scroll-bar__highlight {
    font-weight: 700;
  }

  .promo-scroll-bar__link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .promo-scroll-bar__link:hover,
  .promo-scroll-bar__link:focus-visible {
    text-decoration-thickness: 2px;
  }

  @media (min-width: 750px) {
    .promo-scroll-bar {
      padding: 11px 20px;
    }

    .promo-scroll-bar__text {
      font-size: 13px;
      letter-spacing: 0.035em;
    }
  }

  @media (max-width: 749px) {
    .promo-scroll-bar {
      padding: 9px 12px;
    }

    .promo-scroll-bar__text {
      font-size: 11px;
      letter-spacing: 0.02em;
      line-height: 1.4;
    }
  }
</style>

{% schema %}
{
  "name": "Promo Bar",
  "settings": [],
  "presets": [
    { "name": "Promo Bar" }
  ]
}
{% endschema %}
