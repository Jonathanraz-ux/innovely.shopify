<section id="probleme" class="bg-paper-deep/60">
  <style>
    /* base.css `.grid` injects 14 named columns (grid-template-areas
       column-0..13) at >=750px, which overrides the Tailwind 2-col utility
       and collapses the layout. Reset it here, scoped to this section. */
    @media screen and (min-width: 750px) and (max-width: 63.999rem) {
      #probleme .mx-auto.grid {
        grid-template-columns: 1fr;
        grid-template-areas: none;
      }
    }
    @media screen and (min-width: 64rem) {
      #probleme .mx-auto.grid {
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
        grid-template-areas: none;
      }
    }

    /* Inner stats row (sm:grid-cols-3): base.css `.grid` re-injects the 14
       named columns here too at >=750px, collapsing the three stat cards to
       min-content (the "872 h0x %" letter-stacking). Force 3 real tracks. */
    @media screen and (min-width: 750px) {
      #probleme .sm\:grid-cols-3 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        grid-template-areas: none;
      }
    }
  </style>
  <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 py-24 sm:px-8 lg:grid-cols-[1fr_0.9fr] lg:py-32">
    <div>
      <div class="reveal in-view">
        <p class="eyebrow">{% render 'translate', key: 'innovely.problem.eyebrow', fallback: section.settings.eyebrow %}</p>
      </div>
      <div class="reveal in-view" style="transition-delay: 80ms;">
        <h2 class="mt-6 font-display text-4xl leading-[1.1] tracking-tight sm:text-5xl">
          {% render 'translate', key: 'innovely.problem.title_html', fallback: section.settings.title %}
        </h2>
      </div>
      <div class="reveal in-view" style="transition-delay: 160ms;">
        <div class="mt-7 space-y-5 text-lg leading-relaxed text-muted">
          {% render 'translate', key: 'innovely.problem.text_html', fallback: section.settings.text %}
        </div>
      </div>

      <div class="mt-12 grid gap-10 border-t border-line pt-10 sm:grid-cols-3 sm:gap-6">
        {% for block in section.blocks %}
          <div class="reveal in-view" style="transition-delay: {{ forloop.index0 | times: 100 }}ms;">
            <p class="font-display text-5xl text-ink">{{ block.settings.value }}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              {%- if forloop.index == 1 -%}
                {% render 'translate', key: 'innovely.problem.stat_1_label', fallback: block.settings.label %}
              {%- elsif forloop.index == 2 -%}
                {% render 'translate', key: 'innovely.problem.stat_2_label', fallback: block.settings.label %}
              {%- elsif forloop.index == 3 -%}
                {% render 'translate', key: 'innovely.problem.stat_3_label', fallback: block.settings.label %}
              {%- else -%}
                {{ block.settings.label }}
              {%- endif -%}
            </p>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="reveal in-view relative" style="transition-delay: 200ms;">
      <div class="flex flex-col gap-5">
        <div class="img-zoom relative aspect-[4/3] overflow-hidden rounded-4xl border border-line shadow-card">
          {% if section.settings.image != blank %}
            <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | strip_html | escape }}" class="h-full w-full object-cover" loading="lazy" />
          {% else %}
            <img src="{{ 'product-hand-close-up.jpg' | asset_url }}" alt="Smart Posture Corrector close up" class="h-full w-full object-cover" loading="lazy" />
          {% endif %}
          <div class="absolute inset-0 bg-gradient-to-t from-ink/55 via-transparent to-transparent"></div>
          <div class="absolute left-5 top-5 flex items-center gap-2 rounded-full border border-line bg-paper/90 px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-ink backdrop-blur">
            <span class="relative flex h-2 w-2">
              <span class="animate-pulse-ring absolute inline-flex h-full w-full rounded-full bg-brand/50"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-brand"></span>
            </span>
            {% render 'translate', key: 'innovely.problem.badge', fallback: section.settings.badge %}
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-2xl bg-brand-soft p-4">
          <span class="mt-0.5 text-lg">↗</span>
          <p class="text-sm leading-relaxed text-ink-soft">{% render 'translate', key: 'innovely.problem.tip_html', fallback: section.settings.tip %}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Problem",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Le problème"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title (HTML)",
      "default": "Vos écrans ruinent votre posture. <em class=\"text-brand\">Lentement, mais sûrement.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>On commence par « juste un cours », « un dernier mail », « un épisode de plus ». Huit heures plus tard, les épaules sont tombées, la tête avance, et le dos encaisse en silence.</p><p>Ce que vous ressentez — fatigue, tensions, mal de dos — c'est votre corps qui vous réclame une posture que personne ne vous a jamais apprise. Le pire ? On finit par s'y habituer. Jusqu'au jour où ça devient la norme.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "8h / jour"
    },
    {
      "type": "html",
      "id": "tip",
      "label": "Tip Text (HTML)",
      "default": "<span class=\"font-semibold text-ink\">Chaque centimètre</span> que votre tête avance ajoute jusqu'à <span class=\"font-semibold text-ink\">4 kg</span> de pression sur vos cervicales. Votre dos le porte pour vous. Chaque jour."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "8h"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "passées en moyenne assis face aux écrans chaque jour"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Problem",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
