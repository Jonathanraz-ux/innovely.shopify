<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% if template.name == 'index' %}
      <link rel="preload" as="image" href="{{ 'hero-posture-before-after.jpg' | asset_url }}" fetchpriority="high" width="750" height="939">
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        (function setHeaderHeightCustomProperties() {
          const header = document.querySelector('header-component');
          const headerGroup = document.querySelector('#header-group');
          if (!header || !headerGroup) return;
          const hasHeaderSection = headerGroup.querySelector('.header-section');
          const headerTopRow = header.querySelector('.header__row--top');
          const hRect = header.getBoundingClientRect();
          const headerHeight = hRect.height;
          let headerGroupHeight = 0;
          const children = headerGroup.children;
          for (let i = 0; i < children.length; i++) {
            const el = children[i];
            if (el === header || !(el instanceof HTMLElement)) continue;
            headerGroupHeight += el.getBoundingClientRect().height;
          }
          if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
            headerGroupHeight += headerHeight;
          }
          const s = document.body.style;
          s.setProperty('--header-height', headerHeight + 'px');
          s.setProperty('--header-group-height', headerGroupHeight + 'px');
          if (headerTopRow) {
            s.setProperty('--top-row-height', headerTopRow.getBoundingClientRect().height + 'px');
          }
          if (!hasHeaderSection || !header.hasAttribute('transparent')) {
            s.setProperty('--transparent-header-offset-boolean', '0');
            return;
          }
          s.setProperty('--transparent-header-offset-boolean', hasHeaderSection.nextElementSibling?.classList.contains('shopify-section') ? '0' : '1');
        })();
        (function() {
          var h = document.querySelector('#header-component');
          if (h) {
            var t = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            var o = h.querySelector('overflow-list');
            h.dataset.menuStyle = t || (o && o.hasAttribute('minimum-reached')) ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
