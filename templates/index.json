        "q1": { "type": "faq_item", "settings": { "question": "How does the Innovely posture sensor work?", "answer": "Innovely uses a 6-axis gyroscope that detects micro-slouches of your spine in real time. It emits a gentle vibration as soon as you slouch past your ideal posture threshold." } },
