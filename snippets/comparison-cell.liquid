{% if value == 'check' %}
  <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-brand text-paper">
    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
  </span>
{% elsif value == 'cross' %}
  <span class="inline-flex h-6 w-6 items-center justify-center rounded-full border border-line text-muted/40">
    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </span>
{% else %}
  <div class="flex flex-col items-center gap-1">
    <span class="inline-flex h-6 w-6 items-center justify-center rounded-full border border-brand/30 text-brand">
      <span class="text-xs">≈</span>
    </span>
    {% if note != blank %}
      <span class="text-[10px] leading-none text-muted">{{ note }}</span>
    {% endif %}
  </div>
{% endif %}
